{
  "id": "spacer",
  "title": "Spacer: Interstellar Roleplaying in the Far Future",
  "description": "Unofficial system for Spacer by Bryan Larkin (Arcane Sword Press). Automated 2D task rolls, combat and damage, lifepath character creation, starships, vehicles, world generation, trade, patrons, and encounters, with the full written content of the book (CC BY-SA 4.0). Code under MIT.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Cristian"
    }
  ],
  "license": "LICENSE",
  "esmodules": [
    "module/spacer.mjs"
  ],
  "styles": [
    "styles/spacer.css",
    "styles/craft.css",
    "styles/chargen.css",
    "styles/tools.css"
  ],
  "languages": [
