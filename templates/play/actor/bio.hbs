<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="bio">
  <h3 class="sp-section">{{localize "SPACER.Sheet.Biography"}}</h3>
  <prose-mirror name="system.biography" class="sp-editor" toggled value="{{system.biography}}" {{#unless editable}}disabled{{/unless}}>{{{enriched.biography}}}</prose-mirror>
  <h3 class="sp-section">{{localize "SPACER.Sheet.Notes"}}</h3>
  <prose-mirror name="system.notes" class="sp-editor" toggled value="{{system.notes}}" {{#unless editable}}disabled{{/unless}}>{{{enriched.notes}}}</prose-mirror>
</section>
