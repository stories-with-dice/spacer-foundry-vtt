<div class="spacer spacer-tools-card">
  <header class="stc-header">
    <i class="{{icon}}" inert></i>
    <div>
      <h3>{{title}}</h3>
      {{#if subtitle}}<p class="stc-sub">{{subtitle}}</p>{{/if}}
    </div>
  </header>
  {{#if headline}}<p class="stc-headline">{{headline}}</p>{{/if}}
  {{#each sections}}
  <section class="stc-section">
    {{#if heading}}<h4>{{heading}}</h4>{{/if}}
    {{#if rows}}
    <dl class="stc-rows">
      {{#each rows}}<dt>{{label}}</dt><dd>{{value}}{{#if note}} <span class="stc-note">{{note}}</span>{{/if}}</dd>{{/each}}
    </dl>
    {{/if}}
    {{#if list}}<ul class="stc-list">{{#each list}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if text}}<p class="stc-text">{{text}}</p>{{/if}}
  </section>
  {{/each}}
  {{#if buttons}}
  <div class="stc-buttons">
    {{#each buttons}}
    <button type="button" data-action="{{action}}" {{#if uuid}}data-uuid="{{uuid}}"{{/if}}><i class="{{icon}}" inert></i> {{label}}</button>
    {{/each}}
  </div>
  {{/if}}
  {{#if footer}}<footer class="stc-footer">{{footer}}</footer>{{/if}}
</div>
